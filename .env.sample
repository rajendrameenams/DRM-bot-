# ==============================================================
# Telegram DRM Bot Configuration
# ==============================================================

# Required: Telegram Bot Token from @BotFather
BOT_TOKEN=

# Required: Telegram API ID and API HASH from https://my.telegram.org/apps
API_ID=
API_HASH=

# Optional but Recommended: Comma-separated User IDs allowed to use the bot
# Example: AUTH_USERS=123456789,987654321
AUTH_USERS=

# Optional: Comma-separated Group IDs where the bot is allowed to work
# Example: GROUPS=-1001234567890
GROUPS=

# Optional: Channel ID to receive bot log notifications (Bot must be admin in this channel)
# Example: LOG_CH=-1001234567890
LOG_CH=

# Optional: Custom Download and Session directories
DOWNLOAD_LOCATION=./DOWNLOADS
SESSIONS=./SESSIONS

# Optional: Third-party Tokens
# CPTOKEN=
# SPROUT_URL=https://discuss.oliveboard.in/
# ADDA_TOKEN=
# THUMB_URL=https://telegra.ph/file/fd7a1e0e94a1f3e7d8b3a.jpg

